# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Guild where the bot is restricted to.
# ALLOWED_GUILD_ID is preferred; GUILD_ID also works.
ALLOWED_GUILD_ID=1531847605645082664

# Comma-separated role IDs that can use moderation/staff commands.
# ALLOWED_ROLE_IDS is preferred; STAFF_ROLE_ID can be used for a single role.
ALLOWED_ROLE_IDS=1531861205470416936,1531860536193450174,1531860022814965902

# Optional: category ID where ticket channels are created
TICKET_CATEGORY_ID=

# Optional: comma-separated staff role IDs who can view ticket channels.
# Used for ticket permission overwrites.
STAFF_ROLE_ID=1531861205470416936,1531860536193450174,1531860022814965902

# Optional: role ID that is pinged in every new ticket (default: 1531861205470416936)
TICKET_PING_ROLE_ID=1531861205470416936

# Optional: comma-separated role IDs who can claim a ticket
TICKET_CLAIM_ROLE_IDS=1531860536193450174,1531861205470416936

# Optional: role ID pinged when a ticket is escalated (default: 1531860536193450174)
ESCALATION_ROLE_ID=1531860536193450174

# Optional: channel ID where ticket close logs + transcripts are sent
TICKET_LOG_CHANNEL_ID=

# Optional: channel ID where hourly EXP drops are sent
EXP_CHANNEL_ID=

# Optional: channel ID where the ticket panel is auto-posted on startup
TICKET_PANEL_CHANNEL_ID=1532222077480730744
