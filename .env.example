# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Guild where the bot is restricted to
ALLOWED_GUILD_ID=1531847605645082664

# Comma-separated role IDs that can use moderation/staff commands
